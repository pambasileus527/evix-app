# 公開URL（サイトマップ・構造化データ・canonical に使用）。未設定なら https://evix-app.vercel.app
NEXT_PUBLIC_SITE_URL=https://evix-app.vercel.app

# Supabase（Project Settings > API Keys）。公開してよい値だけを入れる。
# service_role / secret キーは絶対にここへ書かない。
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxx
